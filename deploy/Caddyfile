# Caddy reverse proxy for tinysonic. Caddy obtains and renews the TLS
# certificate automatically, provided the domain resolves to this host and
# ports 80 and 443 are reachable.
#
# Replace music.example.com with the domain in base_url, then:
#   install -m 0644 deploy/Caddyfile /etc/caddy/Caddyfile
#   systemctl reload caddy

music.example.com {
    # Compresses JSON responses (a full song list shrinks about 4x). Audio
    # and images are already compressed; Caddy skips those types itself.
    encode zstd gzip

    # Caps request bodies at 1 MiB, matching tinysonic.
    request_body {
        max_size 1MB
    }

    # Subpath variant (base_path = "/folksonic", deploy/folksonic.toml): paste
    # this into the existing site's block instead of using a site of its own.
    # handle keeps the prefix (handle_path would strip it); the matcher also
    # catches /folksonic without the slash, which tinysonic redirects.
    #
    # @folksonic path /folksonic /folksonic/*
    # handle @folksonic {
    #     reverse_proxy 127.0.0.1:4534 {
    #         flush_interval -1
    #         header_up X-Forwarded-Proto {scheme}
    #     }
    # }

    reverse_proxy 127.0.0.1:4534 {
        # Stream audio without buffering it.
        flush_interval -1
        header_up X-Forwarded-Proto {scheme}
    }
}
